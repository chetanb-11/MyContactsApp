@model MyContactsApp.Core.Models.Contact
@{
    ViewData["Title"] = "Add New Contact";
}

<h2>Add New Contact</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success" style="color: green; margin-bottom: 15px;">
        @TempData["Message"]
    </div>
}

<form asp-controller="Contact" asp-action="AddContact" method="post">
    <div>
        <label asp-for="FirstName">First Name:</label>
        <input type="text" asp-for="FirstName" required />
    </div>

    <div>
        <label asp-for="LastName">Last Name:</label>
        <input type="text" asp-for="LastName" required />
    </div>

    <div>
        <label asp-for="Address">Address:</label>
        <input type="text" asp-for="Address" />
    </div>

    <div>
        <label asp-for="City">City:</label>
        <input type="text" asp-for="City" />
    </div>

    <div>
        <label asp-for="State">State:</label>
        <input type="text" asp-for="State" />
    </div>

    <div>
        <label asp-for="Zip">Zip Code:</label>
        <input type="text" asp-for="Zip" />
    </div>

    <div>
        <label asp-for="PhoneNumber">Phone Number:</label>
        <input type="tel" asp-for="PhoneNumber" />
    </div>

    <div>
        <label asp-for="Email">Email:</label>
        <input type="email" asp-for="Email" required />
    </div>

    <div style="margin-top: 15px;">
        <button type="submit">Save Contact</button>
    </div>
</form>