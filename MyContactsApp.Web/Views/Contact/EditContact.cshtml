@model MyContactsApp.Core.Models.Contact
@{
    ViewData["Title"] = "Edit Contact";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0">Edit Contact</h4>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <form asp-controller="Contact" asp-action="EditContact" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_ContactFormFields.cshtml" model="Model"/>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
