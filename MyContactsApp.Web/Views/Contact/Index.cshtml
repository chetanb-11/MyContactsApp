@model IEnumerable<Contact>
@using MyContactsApp.Core.Models
@{
    ViewData["Title"] = "Contacts Dashboard";
    // ViewData["SearchQuery"]
    // List<Contact> contacts = ViewBag.contacts ?? new List<Contact>();
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <h1 class="display-6 fw-bold mb-2">Address Book & Contacts</h1>
                <p class="text-muted mb-4">Easily create, update, and browse through your contact list.</p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Contact" asp-action="Add" class="btn btn-primary px-4 py-2">
                        + Add New Contact
                    </a>
                    <a asp-controller="Contact" asp-action="ShowAll" class="btn btn-outline-primary px-4 py-2">
                        View All Contacts
                    </a>
                    <form asp-controller="Contact" asp-action="Index" method="get" class="d-flex">
                        <input type = "text" name="searchQuery" class="form-control" placeholder="Search...">
                        <button type="submit" class="btn btn-outline-primary ms-2">Search</button>
                    </form>
                </div>
            </div>
            <div>
                <partial name="_ShowContactTable" model="Model"/>
            </div>
        </div>
    </div>
</div>
