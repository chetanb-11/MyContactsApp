@{
    ViewData["Title"] = "Contacts Dashboard";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <h1 class="display-6 fw-bold mb-2">Address Book & Contacts</h1>
                <p class="text-muted mb-4">Easily create, update, and browse through your contact list.</p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Contact" asp-action="AddContact" class="btn btn-primary px-4 py-2">
                        + Add New Contact
                    </a>
                    <a asp-controller="Contact" asp-action="ShowAllContacts" class="btn btn-outline-primary px-4 py-2">
                        View All Contacts
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
