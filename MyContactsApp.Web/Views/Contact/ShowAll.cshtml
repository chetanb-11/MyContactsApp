@model IEnumerable<MyContactsApp.Core.Models.Contact>

@{
    ViewData["Title"] = "All Contacts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">All Contacts</h2>
            @if (ViewBag.TotalContacts != null)
            {
                <span class="badge bg-secondary fs-6">
                    Total contacts in all address books: @ViewBag.TotalContacts
                </span>
            }
        </div>
        <a asp-controller="Contact" asp-action="Add" class="btn btn-primary">
            + Add New Contact
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No contacts found. Click "Add New Contact" to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Address Book</th>
                        <th>Address</th>
                        <th>City / State / Zip</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@contact.FirstName @contact.LastName</td>
                            <td>
                                @if (contact.AddressBook != null)
                                {
                                    <span class="badge bg-info text-dark">@contact.AddressBook.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td>@contact.Address</td>
                            <td>@contact.City, @contact.State @contact.Zip</td>
                            <td>@contact.PhoneNumber</td>
                            <td>@contact.Email</td>
                            <td class="text-center">
                                <a asp-controller="Contact" asp-action="Edit" asp-route-id="@contact.Id" class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>
                                <form asp-controller="Contact" asp-action="Delete" asp-route-id="@contact.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
