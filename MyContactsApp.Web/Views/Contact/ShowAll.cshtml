@model IEnumerable<MyContactsApp.Core.Models.Contact>

@{
    ViewData["Title"] = "All Contacts";
    bool groupByState = ViewBag.GroupByState ?? false;
    bool groupByCity = ViewBag.GroupByCity ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">All Contacts</h2>
            @if (ViewBag.TotalContacts != null)
            {
                <span class="badge bg-secondary fs-6">
                    Total contacts in all address books: @ViewBag.TotalContacts
                </span>
            }
        </div>
        <a asp-controller="Contact" asp-action="Add" class="btn btn-primary">
            + Add New Contact
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No contacts found. Click "Add New Contact" to create one.
        </div>
    }
    else
    {
        <!-- Auto-submitting checkbox to toggle grouping via GET request -->
        <form asp-action="ShowAll" method="get" class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" 
                       type="checkbox" 
                       name="groupByState" 
                       value="true" 
                       id="groupByStateSwitch" 
                       @(groupByState ? "checked" : "") 
                       onchange="this.form.submit();" />
                <label class="form-check-label fw-semibold" for="groupByStateSwitch">
                    Group by state
                </label>
            </div>
        </form>
        
        <form asp-action="ShowAll" method="get" class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" 
                       type="checkbox" 
                       name="groupByCity" 
                       value="true" 
                       id="groupByCitySwitch" 
                       @(groupByCity ? "checked" : "") 
                       onchange="this.form.submit();" />
                <label class="form-check-label fw-semibold" for="groupByCitySwitch">
                    Group by city
                </label>
            </div>
        </form>

        @if (groupByState)
        {
            @foreach (var stateGroup in Model.GroupBy(c => string.IsNullOrWhiteSpace(c.State) ? "No state" : c.State).OrderBy(g => g.Key))
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <h5 class="mb-0 fw-bold text-primary">
                            <i class="bi bi-geo-alt"></i> @stateGroup.Key
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <partial name="_ShowContactTable" model="stateGroup" />
                    </div>
                </div>
            }
        } else if (groupByCity)
        {
            @foreach (var cityGroup in Model.GroupBy(c => string.IsNullOrWhiteSpace(c.City) ? "no city" : c.City).OrderBy(g => g.Key))
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <h5 class="mb-0 fw-bold text-primary">
                            <i class="bi bi-geo-alt"></i> @cityGroup.Key
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <partial name="_ShowContactTable" model="cityGroup" />
                    </div>
                </div>
            }
        }
        else
        {
            <partial name="_ShowContactTable" model="Model" />
        }
    }
</div>
