@model IEnumerable<MyContactsApp.Core.Models.Contact>

@{
    ViewData["Title"] = "All Contacts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">All Contacts</h2>
            @if (ViewBag.TotalContacts != null)
            {
                <span class="badge bg-secondary fs-6">
                    Total contacts in all address books: @ViewBag.TotalContacts
                </span>
            }
        </div>
        <a asp-controller="Contact" asp-action="Add" class="btn btn-primary">
            + Add New Contact
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No contacts found. Click "Add New Contact" to create one.
        </div>
    }
    else
    {
        <partial name="_ShowContactTable" model="Model"/>
    }
</div>
