@model IEnumerable<MyContactsApp.Core.Models.Contact>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light text-center text-muted mb-0">
        @* No contacts available to display. *@
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle border">
            <thead class="table-dark">
            <tr>
                <th>
                    <a asp-action="ShowAll" asp-route-sortBy="name" class="text-white">Name</a>
                </th>
                <th>Address Book</th>
                <th>Address</th>
                <th>City / State / Zip</th>
                <th>Phone</th>
                <th>Email</th>
                <th class="text-center">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var contact in Model)
            {
                <tr>
                    <td class="fw-semibold">@contact.FirstName @contact.LastName</td>
                    <td>
                        @if (contact.AddressBook != null)
                        {
                            <span class="badge bg-info text-dark">@contact.AddressBook.Name</span>
                        }
                        else
                        {
                            <span class="text-muted small">None</span>
                        }
                    </td>
                    <td>@contact.Address</td>
                    <td>@contact.City, @contact.State @contact.Zip</td>
                    <td>@contact.PhoneNumber</td>
                    <td>@contact.Email</td>
                    <td class="text-center">
                        <a asp-controller="Contact" asp-action="Edit" asp-route-id="@contact.Id"
                           class="btn btn-sm btn-outline-warning">
                            Edit
                        </a>
                        <form asp-controller="Contact" asp-action="Delete" asp-route-id="@contact.Id" method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this contact?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}